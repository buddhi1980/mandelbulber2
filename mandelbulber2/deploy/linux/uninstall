#!/bin/bash
#
# Mandelbulber v2 - Linux uninstall script
#
# Removes everything that the companion 'install' script placed under the
# given prefix (default /usr): the binary, the shared data, the documentation,
# the desktop entry, the icons and the AppStream metadata.
#
# The user configuration (~/.mandelbulber, ~/.mandelbulber_log.txt) is kept
# on purpose; delete it by hand if you want a complete cleanup.
#
# Usage:  ./uninstall [options] [prefix]
#

set -u

PREFIX="/usr"
PREFIX_GIVEN=""
ASSUME_YES=0

if [ -t 1 ]; then
	C_RESET=$'\033[0m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'
	C_RED=$'\033[1;31m'; C_BLUE=$'\033[1;34m'
else
	C_RESET=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_BLUE=""
fi

info()  { printf '%s\n' "${C_BLUE}==>${C_RESET} $*"; }
ok()    { printf '%s\n' "${C_GREEN}[OK]${C_RESET} $*"; }
warn()  { printf '%s\n' "${C_YELLOW}[WARNING]${C_RESET} $*" >&2; }
die()   { printf '%s\n' "${C_RED}[ERROR]${C_RESET} $*" >&2; exit 1; }

usage() {
	cat <<'EOF'
Usage: ./uninstall [options] [prefix]

Removes Mandelbulber v2 from the given installation prefix.

Arguments:
  prefix            Prefix used during installation (default: /usr).

Options:
  --prefix DIR      Same as the positional argument above.
  -y, --yes         Do not ask for confirmation.
  -l, --list        Only list the files that would be removed, do not remove.
  -h, --help        Show this help.
EOF
}

LIST_ONLY=0
while [ $# -gt 0 ]; do
	case "$1" in
		--prefix)   [ $# -ge 2 ] || die "--prefix requires a directory"; PREFIX="$2"; shift ;;
		--prefix=*) PREFIX="${1#*=}" ;;
		-y|--yes)   ASSUME_YES=1 ;;
		-l|--list)  LIST_ONLY=1 ;;
		-h|--help)  usage; exit 0 ;;
		-*)         die "Unknown option: $1 (see --help)" ;;
		*)
			[ -z "$PREFIX_GIVEN" ] || die "Installation prefix already given; pass it only once"
			PREFIX="$1"; PREFIX_GIVEN=1
			;;
	esac
	shift
done

case "$PREFIX" in
	/*) PREFIX="${PREFIX%/}" ;;
	*) die "Installation prefix must be an absolute path (got: '$PREFIX')" ;;
esac
[ -n "$PREFIX" ] || PREFIX="/"

# All paths that 'install' creates, in addition to the plain removals done
# by the old script (binary, data dir).
TARGETS=(
	"$PREFIX/bin/mandelbulber2"
	"$PREFIX/share/mandelbulber2"
	"$PREFIX/share/doc/mandelbulber2"
	"$PREFIX/share/applications/mandelbulber2.desktop"
	"$PREFIX/share/metainfo/com.github.buddhi1980.mandelbulber2.metainfo.xml"
	"$PREFIX/share/icons/hicolor/256x256/apps/mandelbulber.png"
	"$PREFIX/share/icons/hicolor/256x256/apps/mandelbulber2.png"
	"$PREFIX/share/icons/hicolor/128x128/apps/mandelbulber2.png"
)

info "Removing Mandelbulber v2 from prefix: $PREFIX"
FOUND=0
for t in "${TARGETS[@]}"; do
	if [ -e "$t" ]; then
		echo "    $t"
		FOUND=1
	fi
done
if [ "$FOUND" -eq 0 ]; then
	warn "Nothing was found under $PREFIX. Was the program installed to a different prefix?"
	exit 0
fi

if [ "$LIST_ONLY" -eq 1 ]; then
	echo "List only (-l): nothing was removed."
	exit 0
fi

if [ "$ASSUME_YES" -ne 1 ]; then
	printf 'Do you want to remove the files listed above? [y/N] '
	read -r answer
	case "$answer" in
		y|Y|yes|YES) ;;
		*) die "Uninstall aborted" ;;
	esac
fi

# Remove as the current user; escalate through sudo only when the files
# are outside of our own write access.
remove_path() {
	local target="$1"
	if [ "$(id -u)" -eq 0 ]; then
		rm -rf "$target" && return 0
	fi
	if rm -rf "$target" 2>/dev/null; then
		return 0
	fi
	if command -v sudo >/dev/null 2>&1; then
		sudo rm -rf "$target" && return 0
	fi
	warn "Could not remove $target"
	return 1
}

FAILED=0
for t in "${TARGETS[@]}"; do
	[ -e "$t" ] || continue
	remove_path "$t" || FAILED=1
done

# The desktop database cache belongs to us only when no other application
# entries live in the same directory (typical for custom prefixes).
cache="$PREFIX/share/applications/mimeinfo.cache"
if [ -e "$cache" ] && [ -z "$(ls "$PREFIX/share/applications" 2>/dev/null | grep -v -e '^mimeinfo\.cache$' -e '^mandelbulber2\.desktop$')" ]; then
	remove_path "$cache"
fi

# Drop directories left empty by the removal (children first, only if empty).
for d in "$PREFIX/bin" "$PREFIX/share/applications" "$PREFIX/share/metainfo" \
	"$PREFIX/share/doc/mandelbulber2" "$PREFIX/share/doc" \
	"$PREFIX/share/icons/hicolor/128x128/apps" "$PREFIX/share/icons/hicolor/256x256/apps" \
	"$PREFIX/share/icons/hicolor/128x128" "$PREFIX/share/icons/hicolor/256x256" \
	"$PREFIX/share/icons/hicolor" "$PREFIX/share/icons" \
	"$PREFIX/share/mandelbulber2" "$PREFIX/share" "$PREFIX"; do
	rmdir --ignore-fail-on-non-empty "$d" 2>/dev/null || true
done

# An icon cache produced by our own gtk-update-icon-cache call is only ours
# when no other icon sizes/themes were left behind.
hicolor="$PREFIX/share/icons/hicolor"
if [ -e "$hicolor/icon-theme.cache" ] && [ -z "$(ls -A "$hicolor" | grep -v '^icon-theme.cache$')" ]; then
	remove_path "$hicolor/icon-theme.cache"
	rmdir --ignore-fail-on-non-empty "$hicolor" "$PREFIX/share/icons" "$PREFIX/share" "$PREFIX" 2>/dev/null || true
fi

# Refresh the desktop/icon databases so menus stop showing the old entry.
if [ -d "$PREFIX/share/applications" ] && command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database "$PREFIX/share/applications" 2>/dev/null ||
		{ [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 &&
			sudo -n update-desktop-database "$PREFIX/share/applications" 2>/dev/null; } || true
fi
if [ -d "$PREFIX/share/icons/hicolor" ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
	gtk-update-icon-cache -qtf "$PREFIX/share/icons/hicolor" 2>/dev/null || true
fi

if [ "$FAILED" -ne 0 ]; then
	die "Some files could not be removed. Check the warnings above."
fi

ok "Mandelbulber v2 has been removed from $PREFIX"
echo "User settings in ~/.mandelbulber were kept; delete them manually if you want a full cleanup."
