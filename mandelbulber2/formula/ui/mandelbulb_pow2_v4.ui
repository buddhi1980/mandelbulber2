      <item>
       <widget class="QLabel" name="label_information_general">
        <property name="text">
         <string notr="true">&lt;p&gt;Non-trig mandelbulber pow2 versions&lt;br&gt;with modifier vectors from Bridge 2025 Conference Proceedings paper&lt;br&gt;Reformulating Multiplication for Mandelbrot-like Sets in 3D&lt;br&gt;Eric Zimmermann and Stefan Bruckner&lt;br&gt;Institute for Visual &amp; Analytic Computing, University of Rostock, Germany&lt;br&gt;&lt;/p&gt;&lt;table&gt;
&lt;/table&gt;
&lt;h3&gt;Code&lt;/h3&gt;</string>
        </property>
