      <item>
       <widget class="QLabel" name="label_information_general">
        <property name="text">
         <string notr="true">&lt;p&gt;Chebyshev Bulb — Mandelbulb with Chebyshev polynomial iteration.&lt;/p&gt;&lt;p&gt;Replaces the standard power operation z^power with the Chebyshev polynomial T_degree(x/|x|) * |x|, where T_n(x) = cos(n * arccos(x)) for |x| ≤ 1. This creates sharp, polygonal-like fractal structures with characteristic Chebyshev oscillation patterns. The degree parameter controls the polynomial order (minimum 2), with higher degrees producing more oscillations and sharper features.&lt;/p&gt;</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="openExternalLinks">
         <bool>true</bool>
        </property>
        <property name="textInteractionFlags">
         <set>Qt::LinksAccessibleByMouse|Qt::TextSelectableByMouse</set>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="label_code_content">
        <property name="styleSheet">
         <string notr="true">border-style: outset; border-width: 2px; border-radius: 3px; border-color: black; background-color: #fff5ee; padding: 4px;</string>
        </property>
        <property name="text">
         <string notr="true">&lt;body style="background-color:#fff5ee"&gt;
&lt;pre style="color:#000000; background-color:#fff5ee;  font-family:'Courier New',monospace;"&gt;&lt;span style="color:#2e8b57; font-weight:bold"&gt;void&lt;/span&gt; &lt;span style="color:#00008f"&gt;ChebyshevBulbIteration&lt;/span&gt;&lt;span style="color:#676767"&gt;(&lt;/span&gt;CVector4 &lt;span style="color:#676767"&gt;&amp;amp;&lt;/span&gt;z&lt;span style="color:#676767"&gt;,&lt;/span&gt; &lt;span style="color:#2e8b57; font-weight:bold"&gt;const&lt;/span&gt; sFractal &lt;span style="color:#676767"&gt;*&lt;/span&gt;fractal&lt;span style="color:#676767"&gt;,&lt;/span&gt; sExtendedAux &lt;span style="color:#676767"&gt;&amp;amp;&lt;/span&gt;aux&lt;span style="color:#676767"&gt;)&lt;/span&gt;
&lt;span style="color:#676767"&gt;{&lt;/span&gt;
  &lt;span style="color:#2e8b57; font-weight:bold"&gt;double&lt;/span&gt; degree = fractal-&gt;bulb.degree;
  &lt;span style="color:#2e8b57; font-weight:bold"&gt;double&lt;/span&gt; r = aux.r;
  &lt;span style="color:#2e8b57; font-weight:bold"&gt;double&lt;/span&gt; tx = cos&lt;span style="color:#676767"&gt;(&lt;/span&gt;degree * acos&lt;span style="color:#676767"&gt;(&lt;/span&gt;z.x / r&lt;span style="color:#676767"&gt;)&lt;/span&gt;&lt;span style="color:#676767"&gt;)&lt;/span&gt; * r;
  &lt;span style="color:#2e8b57; font-weight:bold"&gt;double&lt;/span&gt; ty = cos&lt;span style="color:#676767"&gt;(&lt;/span&gt;degree * acos&lt;span style="color:#676767"&gt;(&lt;/span&gt;z.y / r&lt;span style="color:#676767"&gt;)&lt;/span&gt;&lt;span style="color:#676767"&gt;)&lt;/span&gt; * r;
  &lt;span style="color:#2e8b57; font-weight:bold"&gt;double&lt;/span&gt; tz = cos&lt;span style="color:#676767"&gt;(&lt;/span&gt;degree * acos&lt;span style="color:#676767"&gt;(&lt;/span&gt;z.z / r&lt;span style="color:#676767"&gt;)&lt;/span&gt;&lt;span style="color:#676767"&gt;)&lt;/span&gt; * r;
  z = CVector4&lt;span style="color:#676767"&gt;(&lt;/span&gt;tx, ty, tz, 0&lt;span style="color:#676767"&gt;)&lt;/span&gt;;
  aux.DE *= &lt;span style="color:#676767"&gt;(&lt;/span&gt;|T'&lt;span style="color:#676767"&gt;(&lt;/span&gt;x/r&lt;span style="color:#676767"&gt;)&lt;/span&gt;| + |T'&lt;span style="color:#676767"&gt;(&lt;/span&gt;y/r&lt;span style="color:#676767"&gt;)&lt;/span&gt;| + |T'&lt;span style="color:#676767"&gt;(&lt;/span&gt;z/r&lt;span style="color:#676767"&gt;)&lt;/span&gt;|&lt;span style="color:#676767"&gt;)&lt;/span&gt;;
  z += offset;
&lt;span style="color:#676767"&gt;}&lt;/span&gt;
&lt;/pre&gt;
&lt;/body&gt;</string>
        </property>
