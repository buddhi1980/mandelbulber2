     </property>
     <widget class="cDragDropTreeWidget" name="treeWidget_objects">
      <property name="toolTip">
       <string>Hierarchy of all objects in the scene: fractals, primitives and groups. Each line shows the node and object ids, the type, the name, the enable checkbox and the material. Select an item to edit it in the panel below; drag and drop moves items and changes the parent group.</string>
      </property>
      <property name="dragEnabled">
       <bool>true</bool>
      </property>
