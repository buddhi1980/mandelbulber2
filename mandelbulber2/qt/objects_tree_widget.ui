   <item>
    <layout class="QHBoxLayout" name="horizontalLayout">
     <property name="spacing">
      <number>2</number>
     </property>
    </layout>
   </item>
   <item>
    <layout class="QGridLayout" name="gridLayout">
     <property name="leftMargin">
      <number>7</number>
     </property>
     <property name="topMargin">
      <number>7</number>
     </property>
     <item row="1" column="0">
      <widget class="QPushButton" name="pushButton_delete_object">
       <property name="toolTip">
        <string>Removes the selected object or group together with all its children from the scene tree. The 'World' root element cannot be deleted.</string>
       </property>
       <property name="text">
        <string>Delete object</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QPushButton" name="pushButton_add_fractal">
       <property name="toolTip">
        <string>Adds a new fractal object to the tree (into the currently selected group). The fractal formula and its parameters are edited in the panel below. Every fractal object has its own, independent formula settings.</string>
       </property>
       <property name="text">
        <string>Add Fractal</string>
       </property>
      </widget>
     </item>
     <item row="0" column="0">
      <widget class="QPushButton" name="pushButton_add_group">
       <property name="toolTip">
        <string>Adds a container which combines its child objects. Opens a dialog to choose the group type: Hybrid fractal (the child fractal formulas are combined into a single iteration sequence, allowing morphing between them), Boolean ADD (union), Boolean MUL (intersection) or Boolean SUB (difference).</string>
       </property>
       <property name="text">
        <string>Add group</string>
       </property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QPushButton" name="pushButton_add_primitive">
       <property name="toolTip">
        <string>Adds a geometric primitive object to the tree (into the currently selected group). Opens a dialog to choose the primitive type: rectangle, circle, box, cylinder, cone, sphere, torus, plane, water, prism or ellipsoid. Primitives have simple shape parameters (sizes, angles) and are fast to render.</string>
       </property>
       <property name="text">
        <string>Add Primitive</string>
       </property>
      </widget>
     </item>
     <item row="0" column="3">
      <widget class="QPushButton" name="pushButton_duplicate">
       <property name="toolTip">
        <string>Creates a copy of the selected object together with its entire subtree, using new node and object ids, and adds it to the same group.</string>
       </property>
       <property name="text">
        <string>Duplicate</string>
       </property>
      </widget>
     </item>
     <item row="1" column="3">
      <widget class="QPushButton" name="pushButton_refresh">
       <property name="toolTip">
        <string>Rebuilds the object tree from the parameters. Useful when the scene was changed elsewhere and the list needs to be synchronized.</string>
       </property>
       <property name="text">
        <string>Refresh</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1" colspan="2">
      <widget class="QCheckBox" name="checkBox_displayWireFramePreviews">
       <property name="toolTip">
        <string>Displays wire-frame previews of the primitives and origin crosses of the objects in the render window. The overlay follows the parameter edits while this option is enabled.</string>
       </property>
       <property name="text">
        <string>Display wire-frame previews</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QSplitter" name="splitter">
     <property name="sizePolicy">
      <sizepolicy hsizetype="MinimumExpanding" vsizetype="Preferred">
